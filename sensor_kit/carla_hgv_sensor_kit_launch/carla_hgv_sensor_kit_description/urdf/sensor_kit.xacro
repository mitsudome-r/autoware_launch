<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Same sensor set and frame names as carla_sensor_kit; only the calibration values differ.
       The macro reads sensor_kit_calibration.yaml from $(arg config_dir), which autoware.launch.xml
       sets to this package's config directory. -->
  <xacro:arg name="config_dir" default="$(find carla_hgv_sensor_kit_description)/config"/>
  <xacro:include filename="$(find carla_sensor_kit_description)/urdf/sensor_kit.xacro"/>
</robot>
